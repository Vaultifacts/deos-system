{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Write(./CLAUDE.md)",
      "Write(./docs/**)",
      "Write(./.claude/**)",
      "Write(./.github/**)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add .)",
      "Bash(git commit -m *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(pwsh -File ./.claude/hooks/*.ps1)",
      "Bash(powershell -File ./.claude/hooks/*.ps1)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(pytest *)",
      "Bash(python *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/node_modules/**)",
      "Bash(curl *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(Invoke-RestMethod *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ps1\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected-write.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.ps1\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-test.ps1\""
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-claim-done.ps1\""
          }
        ]
      }
    ]
  }
}